# Neo4j connection (required). For AuraDB use neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Must be at least 8 characters. Also used by docker-compose for the local database.
NEO4J_PASSWORD=change-me-please

# Optional: leave these unless you need them.

# Repository the scan_repo tool analyses (a path on the machine running the server)
# REPO_PATH=/path/to/repo/to/scan

# Comma-separated globs of repo-relative paths to skip when scanning
# SCAN_EXCLUDE=tests/fixtures/*,migrations/*

# Bearer token for the HTTP server. REQUIRED when MCP_TRANSPORT=http (the server
# refuses to start without it); unused over stdio. At least 32 characters, no
# whitespace. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=

# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO

# stdio (local MCP client) or http (remote server). PORT is also read, for platforms like Railway
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Remote repo to scan (https only). Takes precedence over REPO_PATH.
# REPO_URL=https://github.com/OWNER/REPO.git
# Branch to track (default: the repo's default branch)
# REPO_BRANCH=main
# Token for a private repo: a GitHub fine-grained token limited to that one
# repo, with Contents: Read-only. Leave unset for public repos.
# REPO_TOKEN=
# Where the clone lives (the Docker image sets /data/repo)
# REPO_CHECKOUT_DIR=